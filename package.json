{
  "name": "cv",
  "version": "1.0.0",
  "private": true,
  "description": "Personal CV built from resume.json",
  "scripts": {
    "build": "resumed render resume.json --theme jsonresume-theme-macchiato -o public/index.html",
    "watch": "onchange resume.json themes/macchiato -- npm run build"
  },
  "devDependencies": {
    "jsonresume-theme-macchiato": "file:themes/macchiato",
    "onchange": "^7.1.0",
    "resumed": "^6.1.0"
  }
}
